# Copy this file to .env and replace both example passwords before starting services.
# Do not commit .env or put real credentials in this template.
DB_USER=postgres
DB_PASSWORD=replace-with-a-long-unique-database-password
DB_NAME=myapp_db
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-different-long-unique-password
